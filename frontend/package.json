{
  "name": "pmlytics-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next-with-root-env.mjs dev",
    "build": "node scripts/next-with-root-env.mjs build",
    "start": "node scripts/next-with-root-env.mjs start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
