# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application persistence and Supabase Auth
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTH_REQUIRED=true

# Inference Gateway (OpenRouter)
OPENROUTER_API_KEY=
DEFAULT_MODEL=openai/gpt-5.4

# AI Observability (LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=PMLytics-AI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Product Analytics (PostHog)
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_KEY=

# Local Service Mocks (Test-only defaults for local mock execution)
ZENDESK_BASE_URL=http://localhost:8080
ZENDESK_USERNAME=mock@pocket.test
ZENDESK_API_KEY=mock-zendesk-token-pocket
ZENDESK_TIMEOUT_SECONDS=5.0
JIRA_BASE_URL=http://localhost:1080
JIRA_USERNAME=mock-jira@pocket.test
JIRA_API_TOKEN=mock-jira-token-pocket
JIRA_TIMEOUT_SECONDS=5.0
